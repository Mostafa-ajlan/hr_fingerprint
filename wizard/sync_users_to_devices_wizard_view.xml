<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sync_users_to_devices_wizard_form" model="ir.ui.view">
        <field name="name">sync.users.to.devices.wizard.form</field>
        <field name="model">sync.users.to.devices.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Users To Devices">
                <group>
                    <field name="device_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Sync" type="object" name="action_sync" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sync_users_to_devices_wizard" model="ir.actions.act_window">
        <field name="name">Sync Users To Devices</field>
        <field name="res_model">sync.users.to.devices.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_sync_users_to_devices_wizard_form"/>
    </record>
</odoo> 