<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Fingerprint Templates -->
    <record id="view_hr_fingerprint_template_tree" model="ir.ui.view">
        <field name="name">hr.fingerprint.template.tree</field>
        <field name="model">hr.fingerprint.template</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="display_name"/>
                <field name="finger_name"/>
                <field name="user_id"/>
                <field name="valid"/>
                <field name="device_id"/>
            </list>
        </field>
    </record>

    <!-- Form View for Fingerprint Templates -->
    <record id="view_hr_fingerprint_template_form" model="ir.ui.view">
        <field name="name">hr.fingerprint.template.form</field>
        <field name="model">hr.fingerprint.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="basic_info" string="Basic Information">
                        <group>
                            <field name="display_name"/>    
                            <field name="finger_name"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="device_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action for Fingerprint Template -->
    <record id="action_hr_fingerprint_template" model="ir.actions.act_window">
        <field name="name">Action Fingerprint Template</field>
        <field name="res_model">hr.fingerprint.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- Menu Item for Fingerprint Template -->
    <menuitem id="hr_fingerprint_template_menu" name="Fingerprint Template" parent="menu_fingerprint_root"/>
    <menuitem id="hr_fingerprint_template_menu_action" name="Fingerprint Template" action="action_hr_fingerprint_template" parent="hr_fingerprint_template_menu"/>
</odoo>