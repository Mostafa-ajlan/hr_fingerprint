<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Inherited hr employee for adding new field-->
    <record id="view_employee_form_fingerprint" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.hr.fingerprint</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_type']"
                   position="after">
                <field name="fingerprint_user_number"/>
            </xpath>
        </field>
    </record>
</odoo>
