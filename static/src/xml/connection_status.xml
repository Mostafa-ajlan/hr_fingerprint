<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_fingerprints.ConnectionStatus" owl="1">
        <div t-attf-class="connection-status d-flex align-items-center p-2 rounded #{statusInfo.bgClass}">
            <i t-attf-class="fa #{statusInfo.icon} #{statusInfo.class} me-2"/>
            <span t-esc="statusInfo.text" class="fw-bold"/>
            <t t-if="props.record.data.connection_details">
                <span class="ms-2 text-muted small">
                    (<t t-esc="props.record.data.connection_details"/>)
                </span>
            </t>
        </div>
    </t>

</templates>